{
  "id": "vita3k",
  "name": "Vita3K",
  "license": "GPL-3.0-only",
  "homepage": "https://vita3k.org",
  "icon": "https://raw.githubusercontent.com/Vita3K/Vita3K/master/android/app/src/main/res/mipmap/ic_launcher.png",
  "kind": "standalone",
  "systems": [
    "psvita"
  ],
  "sources": [
    {
      "type": "github",
      "repo": "Vita3K/Vita3K",
      "assets": {
        "linux-x86_64": "^Vita3K-x86_64\\.AppImage$",
        "linux-aarch64": "^Vita3K-aarch64\\.AppImage$",
        "macos-aarch64": "^macos-arm64-latest\\.dmg$",
        "macos-x86_64": "^macos-latest\\.dmg$",
        "windows-x86_64": "^windows-latest\\.zip$"
      }
    },
    {
      "type": "path",
      "names": [
        "Vita3K",
        "vita3k"
      ]
    },
    {
      "type": "macApp",
      "bundle": "Vita3K.app"
    }
  ],
  "binaries": {
    "linux": [
      "Vita3K-*.AppImage",
      "Vita3K"
    ],
    "macos": [
      "Vita3K.app"
    ],
    "windows": [
      "Vita3K.exe"
    ]
  },
  "launch": {
    "args": [
      {
        "if": "fullscreen",
        "args": [
          "--fullscreen"
        ]
      },
      "{rom}"
    ]
  },
  "options": [
    {
      "id": "fullscreen",
      "kind": "toggle",
      "default": true
    }
  ],
  "exitHotkey": "Esc",
  "experimental": true
}
