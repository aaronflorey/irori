    "type.overline.family": {"type":"string","value":"$font.sans"},
    "type.overline.size": {"type":"number","value":11},
    "type.overline.style": {"type":"string","value":"normal"},
    "type.overline.tracking": {"type":"number","value":0.6},
    "type.overline.weight": {"type":"number","value":700},
    "type.title.color": {"type":"color","value":"$color.text"},
    "type.title.family": {"type":"string","value":"$font.sans"},
    "type.title.size": {"type":"number","value":30},
    "type.title.style": {"type":"string","value":"normal"},
    "type.title.tracking": {"type":"number","value":-0.3},
    "type.title.weight": {"type":"number","value":700}
  },
  "children": [
    {"id":"board","type":"frame","fill":"$color.bg.page","height":912,"layout":"none","name":"Irori components","width":3080,"x":-40,"y":-40,"children":[
      {"id":"button-primary","type":"frame","alignItems":"center","cornerRadius":"$radius.md","fill":"$color.brand","gap":"$space.2","height":"$size.control","justifyContent":"center","layout":"horizontal","name":"Button / Primary","padding":[0,"$space.4"],"reusable":true,"x":40,"y":40,"children":[
        {"id":"button-primary-icon","type":"icon","fill":"$color.on-brand","height":16,"icon":"folder-search","library":"lucide","width":16},
        {"id":"button-primary-label","type":"text","content":"Locate files","fill":"$color.on-brand","fontFamily":"$type.body-strong.family","fontSize":"$type.body-strong.size","fontStyle":"$type.body-strong.style","fontWeight":"$type.body-strong.weight","letterSpacing":"$type.body-strong.tracking"}
      ]},
      {"id":"button-secondary","type":"frame","alignItems":"center","cornerRadius":"$radius.md","fill":"$color.bg.control","gap":"$space.2","height":"$size.control","layout":"horizontal","name":"Button / Secondary","padding":[0,"$space.3"],"reusable":true,"stroke":"$color.border-input","strokeAlignment":"inner","strokeWidth":1,"x":40,"y":96,"children":[
        {"id":"button-secondary-icon","type":"icon","fill":"$color.text","height":16,"icon":"plus","library":"lucide","width":16},
        {"id":"button-secondary-label","type":"text","content":"Add game","fill":"$type.body.color","fontFamily":"$type.body.family","fontSize":"$type.body.size","fontStyle":"$type.body.style","fontWeight":"$type.body.weight","letterSpacing":"$type.body.tracking"}
      ]},
      {"id":"button-icon","type":"frame","alignItems":"center","cornerRadius":"$radius.full","fill":"$color.bg.control","height":"$size.control","justifyContent":"center","layout":"horizontal","name":"Button / Icon","reusable":true,"stroke":"$color.border-input","strokeAlignment":"inner","strokeWidth":1,"width":"$size.control","x":40,"y":152,"children":[
        {"id":"button-icon-glyph","type":"icon","fill":"$color.text","height":16,"icon":"star","library":"lucide","width":16}
      ]},
      {"id":"input-search","type":"frame","alignItems":"center","cornerRadius":"$radius.md","fill":"$color.bg.control","gap":"$space.2","height":"$size.control","layout":"horizontal","name":"Input / Search","padding":[0,"$space.3"],"reusable":true,"stroke":"$color.border-input","strokeAlignment":"inner","strokeWidth":1,"width":280,"x":40,"y":208,"children":[
        {"id":"input-search-icon","type":"icon","fill":"$color.text-muted","height":16,"icon":"search","library":"lucide","width":16},
        {"id":"input-search-placeholder","type":"text","content":"Search library","fill":"$color.text-muted","fontFamily":"$type.body.family","fontSize":"$type.body.size","fontStyle":"$type.body.style","fontWeight":"$type.body.weight","letterSpacing":"$type.body.tracking"}
      ]},
      {"id":"input-path","type":"frame","alignItems":"center","cornerRadius":"$radius.md","fill":"$color.bg.control","gap":"$space.2","height":"$size.control","layout":"horizontal","name":"Input / Path","padding":[0,"$space.3"],"reusable":true,"stroke":"$color.border-input","strokeAlignment":"inner","strokeWidth":1,"width":300,"x":40,"y":264,"children":[
        {"id":"input-path-value","type":"text","content":"/home/aaron/Games/Irori","fill":"$type.body.color","fontFamily":"$type.body.family","fontSize":"$type.body.size","fontStyle":"$type.body.style","fontWeight":"$type.body.weight","letterSpacing":"$type.body.tracking","width":"fill_container"},
        {"id":"input-path-icon","type":"icon","fill":"$color.text","height":16,"icon":"folder-open","library":"lucide","width":16}
      ]},
      {"id":"select","type":"frame","alignItems":"center","cornerRadius":"$radius.md","fill":"$color.bg.control","gap":"$space.2","height":"$size.control","layout":"horizontal","name":"Select","padding":[0,"$space.3"],"reusable":true,"stroke":"$color.border-input","strokeAlignment":"inner","strokeWidth":1,"width":240,"x":40,"y":320,"children":[
        {"id":"select-value","type":"text","content":"English","fill":"$type.body.color","fontFamily":"$type.body.family","fontSize":"$type.body.size","fontStyle":"$type.body.style","fontWeight":"$type.body.weight","letterSpacing":"$type.body.tracking","width":"fill_container"},
        {"id":"select-chevron","type":"icon","fill":"$color.text","height":16,"icon":"chevron-down","library":"lucide","width":16}
      ]},
      {"id":"toggle-on","type":"frame","alignItems":"center","cornerRadius":"$radius.full","fill":"$color.brand","height":22,"justifyContent":"end","layout":"horizontal","name":"Toggle / On","padding":"$space.1","reusable":true,"width":40,"x":40,"y":376,"children":[
        {"id":"toggle-on-knob","type":"ellipse","fill":"$color.on-brand","height":14,"width":14}
      ]},
      {"id":"toggle-off","type":"frame","alignItems":"center","cornerRadius":"$radius.full","fill":"$color.switch-off","height":22,"justifyContent":"start","layout":"horizontal","name":"Toggle / Off","padding":"$space.1","reusable":true,"width":40,"x":96,"y":376,"children":[
        {"id":"toggle-off-knob","type":"ellipse","fill":"$color.text","height":14,"width":14}
      ]},
      {"id":"badge","type":"frame","alignItems":"center","cornerRadius":"$radius.sm","fill":"$color.bg.control","layout":"horizontal","name":"Badge","padding":["$space.1","$space.2"],"reusable":true,"stroke":"$color.border","strokeAlignment":"inner","strokeWidth":1,"x":40,"y":416,"children":[
        {"id":"badge-label","type":"text","content":"Windows","fill":"$color.text","fontFamily":"$type.caption.family","fontSize":"$type.caption.size","fontStyle":"$type.caption.style","fontWeight":"$type.caption.weight","letterSpacing":"$type.caption.tracking"}
      ]},
      {"id":"nav-item","type":"frame","alignItems":"center","cornerRadius":"$radius.md","gap":"$space.3","height":"$size.nav-row","layout":"horizontal","name":"Nav / Item","padding":[0,"$space.3"],"reusable":true,"width":216,"x":400,"y":40,"children":[
        {"id":"nav-item-icon","type":"icon","fill":"$color.text-sidebar","height":18,"icon":"download","library":"lucide","width":18},
        {"id":"nav-item-label","type":"text","content":"Downloads","fill":"$type.nav.color","fontFamily":"$type.nav.family","fontSize":"$type.nav.size","fontStyle":"$type.nav.style","fontWeight":"$type.nav.weight","letterSpacing":"$type.nav.tracking"}
      ]},
      {"id":"nav-item-active","type":"frame","alignItems":"center","clip":true,"cornerRadius":"$radius.md","fill":"$color.bg.sidebar-active","gap":"$space.3","height":"$size.nav-row","layout":"horizontal","name":"Nav / Item active","padding":[0,"$space.3",0,0],"reusable":true,"width":216,"x":400,"y":96,"children":[
        {"id":"nav-item-active-bar","type":"rectangle","cornerRadius":"$radius.full","fill":"$color.brand","height":20,"width":3},
        {"id":"nav-item-active-frame-1","type":"frame","alignItems":"center","gap":"$space.3","layout":"horizontal","children":[
          {"id":"nav-item-active-icon","type":"icon","fill":"$color.brand","height":18,"icon":"library-big","library":"lucide","width":18},
          {"id":"nav-item-active-label","type":"text","content":"Library","fill":"$type.nav-active.color","fontFamily":"$type.nav-active.family","fontSize":"$type.nav-active.size","fontStyle":"$type.nav-active.style","fontWeight":"$type.nav-active.weight","letterSpacing":"$type.nav-active.tracking"}
        ]}
      ]},
      {"id":"view-item","type":"frame","alignItems":"center","cornerRadius":"$radius.md","gap":"$space.3","height":"$size.control","layout":"horizontal","name":"Nav / View","padding":[0,"$space.3"],"reusable":true,"width":216,"x":400,"y":152,"children":[
        {"id":"view-item-icon","type":"icon","fill":"$color.text-muted","height":16,"icon":"bookmark","library":"lucide","width":16},
        {"id":"view-item-label","type":"text","content":"Playing now","fill":"$color.text-sidebar","fontFamily":"$type.body.family","fontSize":"$type.body.size","fontStyle":"$type.body.style","fontWeight":"$type.body.weight","letterSpacing":"$type.body.tracking"}
      ]},
      {"id":"settings-nav-item","type":"frame","alignItems":"center","cornerRadius":"$radius.md","gap":"$space.2","height":"$size.control","layout":"horizontal","name":"Settings nav / Item","padding":[0,"$space.3"],"reusable":true,"width":200,"x":400,"y":200,"children":[
        {"id":"settings-nav-item-icon","type":"icon","fill":"$color.text","height":16,"icon":"palette","library":"lucide","width":16},
        {"id":"settings-nav-item-label","type":"text","content":"Appearance","fill":"$type.body.color","fontFamily":"$type.body.family","fontSize":"$type.body.size","fontStyle":"$type.body.style","fontWeight":"$type.body.weight","letterSpacing":"$type.body.tracking"}
      ]},
      {"id":"settings-nav-item-active","type":"frame","alignItems":"center","cornerRadius":"$radius.md","fill":"$color.bg.control-hover","gap":"$space.2","height":"$size.control","layout":"horizontal","name":"Settings nav / Item active","padding":[0,"$space.3"],"reusable":true,"width":200,"x":400,"y":248,"children":[
        {"id":"settings-nav-item-active-icon","type":"icon","fill":"$color.text","height":16,"icon":"settings","library":"lucide","width":16},
        {"id":"settings-nav-item-active-label","type":"text","content":"General","fill":"$type.body.color","fontFamily":"$type.body.family","fontSize":"$type.body.size","fontStyle":"$type.body.style","fontWeight":"$type.body.weight","letterSpacing":"$type.body.tracking"}
      ]},
      {"id":"tab","type":"frame","alignItems":"center","gap":"$space.2","layout":"vertical","name":"Tab","reusable":true,"x":400,"y":304,"children":[
        {"id":"tab-label","type":"text","content":"Compatibility","fill":"$color.text-muted","fontFamily":"$type.body.family","fontSize":"$type.body.size","fontStyle":"$type.body.style","fontWeight":"$type.body.weight","letterSpacing":"$type.body.tracking"},
        {"id":"tab-indicator","type":"rectangle","fill":"#00000000","height":2,"width":"fill_container"}
      ]},
      {"id":"tab-active","type":"frame","alignItems":"center","gap":"$space.2","layout":"vertical","name":"Tab active","reusable":true,"x":520,"y":304,"children":[
        {"id":"tab-active-label","type":"text","content":"About","fill":"$type.body.color","fontFamily":"$type.body.family","fontSize":"$type.body.size","fontStyle":"$type.body.style","fontWeight":"$type.body.weight","letterSpacing":"$type.body.tracking"},
        {"id":"tab-active-indicator","type":"rectangle","cornerRadius":"$radius.full","fill":"$color.brand","height":2,"width":"fill_container"}
      ]},
      {"id":"segment","type":"frame","alignItems":"center","cornerRadius":"$radius.sm","gap":"$space.2","height":28,"layout":"horizontal","name":"Segment","padding":[0,"$space.3"],"reusable":true,"x":400,"y":360,"children":[
        {"id":"segment-label","type":"text","content":"Installed","fill":"$color.text-sidebar","fontFamily":"$type.body.family","fontSize":"$type.body.size","fontStyle":"$type.body.style","fontWeight":"$type.body.weight","letterSpacing":"$type.body.tracking"}
      ]},
      {"id":"segment-active","type":"frame","alignItems":"center","cornerRadius":"$radius.sm","fill":"$color.bg.control-active","gap":"$space.2","height":28,"layout":"horizontal","name":"Segment active","padding":[0,"$space.3"],"reusable":true,"x":520,"y":360,"children":[
        {"id":"segment-active-label","type":"text","content":"All","fill":"$type.body.color","fontFamily":"$type.body.family","fontSize":"$type.body.size","fontStyle":"$type.body.style","fontWeight":"$type.body.weight","letterSpacing":"$type.body.tracking"}
      ]},
      {"id":"segmented-control","type":"frame","alignItems":"center","cornerRadius":"$radius.md","fill":"$color.bg.control","gap":"$space.1","layout":"horizontal","name":"Segmented control","padding":"$space.1","reusable":true,"stroke":"$color.border","strokeAlignment":"inner","strokeWidth":1,"x":760,"y":40,"children":[
        {"id":"seg-1","type":"ref","ref":"segment-active"},
        {"id":"seg-2","type":"ref","ref":"segment"},
        {"id":"seg-3","type":"ref","descendants":{"segment-label":{"content":"Not installed"}},"ref":"segment"}
      ]},
      {"id":"game-card","type":"frame","gap":"$space.2","layout":"vertical","name":"Game card","reusable":true,"width":180,"x":760,"y":104,"children":[
        {"id":"game-card-cover","type":"frame","clip":true,"cornerRadius":"$radius.sm","fill":"$color.bg.skeleton","height":270,"justifyContent":"space_between","layout":"vertical","padding":"$space.3","width":"fill_container","children":[
          {"id":"game-card-cover-icon","type":"icon","fill":"$color.text-muted","height":16,"icon":"gamepad-2","library":"lucide","width":16},
          {"id":"game-card-cover-title","type":"text","content":"Hades","fill":"$type.heading.color","fontFamily":"$type.heading.family","fontSize":"$type.heading.size","fontStyle":"$type.heading.style","fontWeight":"$type.heading.weight","letterSpacing":"$type.heading.tracking","textGrowth":"fixed-width","width":"fill_container"}
        ]},
        {"id":"game-card-frame-1","type":"frame","gap":"$space.1","layout":"vertical","width":"fill_container","children":[
          {"id":"game-card-title","type":"text","content":"Hades","fill":"$type.body-strong.color","fontFamily":"$type.body-strong.family","fontSize":"$type.body-strong.size","fontStyle":"$type.body-strong.style","fontWeight":"$type.body-strong.weight","letterSpacing":"$type.body-strong.tracking"},
          {"id":"game-card-status","type":"text","content":"Files missing","fill":"$type.caption.color","fontFamily":"$type.caption.family","fontSize":"$type.caption.size","fontStyle":"$type.caption.style","fontWeight":"$type.caption.weight","letterSpacing":"$type.caption.tracking"}
        ]}
      ]},
      {"id":"setting-row","type":"frame","alignItems":"center","gap":"$space.4","layout":"horizontal","name":"Setting row","padding":["$space.4","$space.4"],"reusable":true,"stroke":"$color.border","strokeAlignment":"inner","strokeWidth":{"bottom":1,"left":0,"right":0,"top":0},"width":720,"x":1000,"y":104,"children":[
        {"id":"setting-row-frame-1","type":"frame","gap":"$space.1","layout":"vertical","width":"fill_container","children":[
          {"id":"setting-row-title","type":"text","content":"Check for game updates on startup","fill":"$type.body.color","fontFamily":"$type.body.family","fontSize":"$type.body.size","fontStyle":"$type.body.style","fontWeight":"$type.body.weight","letterSpacing":"$type.body.tracking"},
          {"id":"setting-row-description","type":"text","content":"Minutes between background checks for game updates (5–1440).","fill":"$type.caption.color","fontFamily":"$type.caption.family","fontSize":"$type.caption.size","fontStyle":"$type.caption.style","fontWeight":"$type.caption.weight","letterSpacing":"$type.caption.tracking","textGrowth":"fixed-width","width":"fill_container"}
        ]},
        {"id":"setting-row-control","type":"frame","alignItems":"center","layout":"horizontal","slot":["toggle-on","toggle-off","select","input-path"],"children":[
          {"id":"setting-row-toggle","type":"ref","ref":"toggle-on"}
        ]}
      ]},
      {"id":"settings-card","type":"frame","gap":"$space.3","layout":"vertical","name":"Settings card","reusable":true,"width":720,"x":1000,"y":240,"children":[
        {"id":"settings-card-label","type":"text","content":"UPDATES","fill":"$type.overline.color","fontFamily":"$type.overline.family","fontSize":"$type.overline.size","fontStyle":"$type.overline.style","fontWeight":"$type.overline.weight","letterSpacing":"$type.overline.tracking"},
        {"id":"settings-card-body","type":"frame","clip":true,"cornerRadius":"$radius.lg","fill":"$color.bg.card","layout":"vertical","slot":["setting-row"],"stroke":"$color.border","strokeAlignment":"inner","strokeWidth":1,"width":"fill_container"}
      ]},
      {"id":"detail-row","type":"frame","alignItems":"center","layout":"horizontal","name":"Detail row","padding":["$space.3",0],"reusable":true,"stroke":"$color.border","strokeAlignment":"inner","strokeWidth":{"bottom":1,"left":0,"right":0,"top":0},"width":720,"x":1000,"y":460,"children":[
        {"id":"detail-row-label","type":"text","content":"Playtime","fill":"$color.text-muted","fontFamily":"$type.body.family","fontSize":"$type.body.size","fontStyle":"$type.body.style","fontWeight":"$type.body.weight","letterSpacing":"$type.body.tracking","width":240},
        {"id":"detail-row-value","type":"text","content":"Not played yet","fill":"$type.body.color","fontFamily":"$type.body.family","fontSize":"$type.body.size","fontStyle":"$type.body.style","fontWeight":"$type.body.weight","letterSpacing":"$type.body.tracking"}
      ]},
      {"id":"card","type":"frame","cornerRadius":"$radius.lg","fill":"$color.bg.card","gap":"$space.4","layout":"vertical","name":"Card","padding":"$space.5","reusable":true,"stroke":"$color.border","strokeAlignment":"inner","strokeWidth":1,"width":720,"x":1000,"y":540,"children":[
        {"id":"card-frame-1","type":"frame","alignItems":"center","justifyContent":"space_between","layout":"horizontal","width":"fill_container","children":[
          {"id":"card-title","type":"text","content":"Play history","fill":"$type.heading.color","fontFamily":"$type.heading.family","fontSize":"$type.heading.size","fontStyle":"$type.heading.style","fontWeight":"$type.heading.weight","letterSpacing":"$type.heading.tracking"},
          {"id":"card-actions","type":"frame","gap":"$space.2","layout":"horizontal","slot":["segmented-control","button-secondary"]}
        ]},
        {"id":"card-body","type":"frame","gap":"$space.2","layout":"vertical","slot":["detail-row"],"width":"fill_container"}
      ]},
      {"id":"title-bar","type":"frame","alignItems":"center","fill":"$color.bg.sidebar","height":32,"justifyContent":"space_between","layout":"horizontal","name":"Title bar","padding":[0,"$space.4"],"reusable":true,"stroke":"$color.border-subtle","strokeAlignment":"inner","strokeWidth":{"bottom":1,"left":0,"right":0,"top":0},"width":1280,"x":1760,"y":40,"children":[
        {"id":"title-bar-frame-1","type":"frame","gap":"$space.4","layout":"horizontal","width":120,"children":[
          {"id":"title-bar-icon-2","type":"icon","fill":"$color.text-muted","height":16,"icon":"chevron-left","library":"lucide","width":16},
          {"id":"title-bar-icon-3","type":"icon","fill":"$color.text-muted","height":16,"icon":"chevron-right","library":"lucide","width":16}
        ]},
        {"id":"title-bar-search","type":"frame","alignItems":"center","cornerRadius":"$radius.md","fill":"$color.bg.page","gap":"$space.2","height":24,"justifyContent":"center","layout":"horizontal","stroke":"$color.border-input","strokeAlignment":"inner","strokeWidth":1,"width":352,"children":[
          {"id":"title-bar-icon-4","type":"icon","fill":"$color.text","height":14,"icon":"search","library":"lucide","width":14},
          {"id":"title-bar-text-5","type":"text","content":"Search games and commands…","fill":"$type.body.color","fontFamily":"$type.body.family","fontSize":"$type.body.size","fontStyle":"$type.body.style","fontWeight":"$type.body.weight","letterSpacing":"$type.body.tracking"}
        ]},
        {"id":"title-bar-frame-6","type":"frame","justifyContent":"end","layout":"horizontal","width":120,"children":[
          {"id":"title-bar-icon-7","type":"icon","fill":"$color.text","height":16,"icon":"download","library":"lucide","width":16}
        ]}
      ]},
      {"id":"sidebar","type":"frame","fill":"$color.bg.sidebar","gap":"$space.1","height":768,"layout":"vertical","name":"Sidebar","padding":["$space.5","$space.3","$space.3","$space.3"],"reusable":true,"stroke":"$color.border-subtle","strokeAlignment":"inner","strokeWidth":{"bottom":0,"left":0,"right":1,"top":0},"width":"$size.sidebar","x":1760,"y":104,"children":[
        {"id":"sidebar-frame-1","type":"frame","alignItems":"center","gap":"$space.3","layout":"horizontal","padding":[0,"$space.1","$space.4","$space.1"],"children":[
          {"id":"sidebar-frame-2","type":"frame","alignItems":"center","cornerRadius":"$radius.md","fill":"$color.bg.accent","height":32,"justifyContent":"center","layout":"horizontal","width":32,"children":[
            {"id":"sidebar-icon-3","type":"icon","fill":"$color.brand","height":18,"icon":"flame","library":"lucide","width":18}
          ]},
          {"id":"sidebar-text-4","type":"text","content":"Irori","fill":"$type.heading.color","fontFamily":"$type.heading.family","fontSize":"$type.heading.size","fontStyle":"$type.heading.style","fontWeight":"$type.heading.weight","letterSpacing":"$type.heading.tracking"}
        ]},
        {"id":"sidebar-library","type":"ref","ref":"nav-item-active"},
        {"id":"sidebar-downloads","type":"ref","descendants":{"nav-item-icon":{"icon":"download"},"nav-item-label":{"content":"Downloads"}},"ref":"nav-item"},
        {"id":"sidebar-updates","type":"ref","descendants":{"nav-item-icon":{"icon":"refresh-cw"},"nav-item-label":{"content":"Updates"}},"ref":"nav-item"},
        {"id":"sidebar-stores","type":"ref","descendants":{"nav-item-icon":{"icon":"store"},"nav-item-label":{"content":"Stores"}},"ref":"nav-item"},
        {"id":"sidebar-stats","type":"ref","descendants":{"nav-item-icon":{"icon":"chart-column"},"nav-item-label":{"content":"Stats"}},"ref":"nav-item"},
        {"id":"sidebar-frame-5","type":"frame","layout":"none","padding":["$space.5","$space.3","$space.2","$space.3"],"width":"fill_container","children":[
          {"id":"sidebar-text-6","type":"text","content":"VIEWS","fill":"$type.overline.color","fontFamily":"$type.overline.family","fontSize":"$type.overline.size","fontStyle":"$type.overline.style","fontWeight":"$type.overline.weight","letterSpacing":"$type.overline.tracking"}
        ]},
        {"id":"sidebar-view-1","type":"ref","descendants":{"view-item-label":{"content":"Playing now"}},"ref":"view-item"},
        {"id":"sidebar-view-2","type":"ref","descendants":{"view-item-label":{"content":"Backlog"}},"ref":"view-item"},
        {"id":"sidebar-view-3","type":"ref","descendants":{"view-item-label":{"content":"Ready to play"}},"ref":"view-item"},
        {"id":"sidebar-view-4","type":"ref","descendants":{"view-item-label":{"content":"Recently added"}},"ref":"view-item"},
        {"id":"sidebar-frame-7","type":"frame","height":"fill_container","layout":"none","width":"fill_container"},
        {"id":"sidebar-wine","type":"ref","descendants":{"nav-item-icon":{"icon":"wine"},"nav-item-label":{"content":"Wine & Proton"}},"ref":"nav-item"},
        {"id":"sidebar-emulators","type":"ref","descendants":{"nav-item-icon":{"icon":"joystick"},"nav-item-label":{"content":"Emulators"}},"ref":"nav-item"},
        {"id":"sidebar-accounts","type":"ref","descendants":{"nav-item-icon":{"icon":"circle-user"},"nav-item-label":{"content":"Accounts"}},"ref":"nav-item"},
        {"id":"sidebar-settings","type":"ref","descendants":{"nav-item-icon":{"icon":"settings"},"nav-item-label":{"content":"Settings"}},"ref":"nav-item"},
        {"id":"sidebar-frame-8","type":"frame","alignItems":"center","gap":"$space.2","layout":"horizontal","padding":["$space.3",0,0,0],"width":"fill_container","children":[
          {"id":"sidebar-bigpicture","type":"frame","alignItems":"center","cornerRadius":"$radius.md","fill":"$color.bg.sidebar-active","gap":"$space.3","height":"$size.nav-row","layout":"horizontal","padding":[0,"$space.3"],"width":"fill_container","children":[
            {"id":"sidebar-icon-9","type":"icon","fill":"$color.text","height":18,"icon":"gamepad-2","library":"lucide","width":18},
            {"id":"sidebar-text-10","type":"text","content":"Big Picture","fill":"$type.nav-active.color","fontFamily":"$type.nav-active.family","fontSize":"$type.nav-active.size","fontStyle":"$type.nav-active.style","fontWeight":"$type.nav-active.weight","letterSpacing":"$type.nav-active.tracking"}
          ]},
          {"id":"sidebar-icon-11","type":"icon","fill":"$color.text-muted","height":18,"icon":"panel-left-close","library":"lucide","width":18}
        ]}
      ]}
    ]}
  ],
  "blueline": {
    "schemaVersion": 1,
    "designSystem": {
      "title": "Irori",
      "overview": "Irori is a warm, dark-first game launcher. Surfaces are near-black warm browns (Irori Night) with a single ember-orange accent (color.brand) used sparingly: primary actions, the active nav indicator bar, active tab underline, toggles, sliders and focus. Everything else is neutral. Type is Manrope throughout; hierarchy comes from weight and size, with muted text (color.text-muted) for descriptions. Settings are grouped in rounded cards (radius.lg) with hairline dividers; controls are 32px tall with radius.md. Dark is the default mode; Light mirrors the Irori Day theme. Source: assets/themes/irori.json.",
      "tokens": {
        "color.bg.accent": {
          "group": "Surfaces",
          "description": "Soft brand-tinted highlight."
        },
        "color.bg.card": {
          "group": "Surfaces",
          "description": "Grouped settings cards, detail cards (muted background)."
        },
        "color.bg.control": {
          "group": "Surfaces",
          "description": "Secondary buttons, inputs, selects, segmented controls."
        },
        "color.bg.control-active": {
          "group": "Surfaces",
          "description": "Pressed control; selected segment."
        },
        "color.bg.control-hover": {
          "group": "Surfaces"
        },
        "color.bg.hover": {
          "group": "Surfaces",
          "description": "Row hover overlay."
        },
        "color.bg.page": {
          "group": "Surfaces",
          "description": "Main content background."
        },
        "color.bg.panel": {
          "group": "Surfaces",
          "description": "Secondary panels such as the settings sub-navigation."
        },
        "color.bg.popover": {
          "group": "Surfaces",
          "description": "Menus, popovers, dialogs."
        },
        "color.bg.selected": {
          "group": "Surfaces",
          "description": "Selected list row."
        },
        "color.bg.sidebar": {
          "group": "Surfaces",
          "description": "App sidebar and title bar."
        },
        "color.bg.sidebar-active": {
          "group": "Surfaces",
          "description": "Selected sidebar / settings-nav row."
        },
        "color.bg.skeleton": {
          "group": "Surfaces",
          "description": "Game cover placeholders and loading skeletons."
        },
        "color.border": {
          "group": "Borders",
          "description": "Card outlines, row dividers."
        },
        "color.border-input": {
          "group": "Borders",
          "description": "Inputs, selects, outlined buttons."
