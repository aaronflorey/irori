    "color.on-danger": {"type":"color","value":"#FFFFFF"},
    "color.on-info": {"type":"color","value":[{"theme":{"mode":"Dark"},"value":"#04101F"},{"theme":{"mode":"Light"},"value":"#FFFFFF"}]},
    "color.on-success": {"type":"color","value":[{"theme":{"mode":"Dark"},"value":"#04130A"},{"theme":{"mode":"Light"},"value":"#FFFFFF"}]},
    "color.on-warning": {"type":"color","value":"#1D1400"},
    "color.overlay": {"type":"color","value":[{"theme":{"mode":"Dark"},"value":"#000000A6"},{"theme":{"mode":"Light"},"value":"#1D1B1966"}]},
    "color.success": {"type":"color","value":[{"theme":{"mode":"Dark"},"value":"#4FD18B"},{"theme":{"mode":"Light"},"value":"#1F9D5C"}]},
    "color.switch-off": {"type":"color","value":[{"theme":{"mode":"Dark"},"value":"#2E3038"},{"theme":{"mode":"Light"},"value":"#D9D4CC"}]},
    "color.text": {"type":"color","value":[{"theme":{"mode":"Dark"},"value":"#F3EEE8"},{"theme":{"mode":"Light"},"value":"#1C1815"}]},
    "color.text-accent": {"type":"color","value":[{"theme":{"mode":"Dark"},"value":"#FFC9AB"},{"theme":{"mode":"Light"},"value":"#7A2C05"}]},
    "color.text-muted": {"type":"color","value":[{"theme":{"mode":"Dark"},"value":"#A39A91"},{"theme":{"mode":"Light"},"value":"#6F6760"}]},
    "color.text-sidebar": {"type":"color","value":[{"theme":{"mode":"Dark"},"value":"#CFC7BF"},{"theme":{"mode":"Light"},"value":"#3A342F"}]},
    "color.text-strong": {"type":"color","value":[{"theme":{"mode":"Dark"},"value":"#FFFFFF"},{"theme":{"mode":"Light"},"value":"#1C1815"}]},
    "color.warning": {"type":"color","value":[{"theme":{"mode":"Dark"},"value":"#F5C451"},{"theme":{"mode":"Light"},"value":"#B98500"}]},
    "font.sans": {"type":"string","value":"Manrope"},
    "radius.full": {"type":"number","value":999},
    "radius.lg": {"type":"number","value":14},
    "radius.md": {"type":"number","value":10},
    "radius.sm": {"type":"number","value":6},
    "size.control": {"type":"number","value":32},
    "size.nav-row": {"type":"number","value":40},
    "size.sidebar": {"type":"number","value":240},
    "space.1": {"type":"number","value":4},
    "space.10": {"type":"number","value":40},
    "space.2": {"type":"number","value":8},
    "space.3": {"type":"number","value":12},
    "space.4": {"type":"number","value":16},
    "space.5": {"type":"number","value":20},
    "space.6": {"type":"number","value":24},
    "space.8": {"type":"number","value":32},
    "type.body-strong.color": {"type":"color","value":"$color.text"},
    "type.body-strong.family": {"type":"string","value":"$font.sans"},
    "type.body-strong.size": {"type":"number","value":14},
    "type.body-strong.style": {"type":"string","value":"normal"},
    "type.body-strong.tracking": {"type":"number","value":0},
    "type.body-strong.weight": {"type":"number","value":700},
    "type.body.color": {"type":"color","value":"$color.text"},
    "type.body.family": {"type":"string","value":"$font.sans"},
    "type.body.size": {"type":"number","value":14},
    "type.body.style": {"type":"string","value":"normal"},
    "type.body.tracking": {"type":"number","value":0},
    "type.body.weight": {"type":"number","value":500},
    "type.caption.color": {"type":"color","value":"$color.text-muted"},
    "type.caption.family": {"type":"string","value":"$font.sans"},
    "type.caption.size": {"type":"number","value":12},
    "type.caption.style": {"type":"string","value":"normal"},
    "type.caption.tracking": {"type":"number","value":0},
    "type.caption.weight": {"type":"number","value":400},
    "type.display.color": {"type":"color","value":"$color.text"},
    "type.display.family": {"type":"string","value":"$font.sans"},
    "type.display.size": {"type":"number","value":40},
    "type.display.style": {"type":"string","value":"normal"},
    "type.display.tracking": {"type":"number","value":-0.5},
    "type.display.weight": {"type":"number","value":800},
    "type.heading.color": {"type":"color","value":"$color.text"},
    "type.heading.family": {"type":"string","value":"$font.sans"},
    "type.heading.size": {"type":"number","value":18},
    "type.heading.style": {"type":"string","value":"normal"},
    "type.heading.tracking": {"type":"number","value":0},
    "type.heading.weight": {"type":"number","value":700},
    "type.nav-active.color": {"type":"color","value":"$color.text-strong"},
    "type.nav-active.family": {"type":"string","value":"$font.sans"},
    "type.nav-active.size": {"type":"number","value":"$type.nav.size"},
    "type.nav-active.style": {"type":"string","value":"normal"},
    "type.nav-active.tracking": {"type":"number","value":0},
    "type.nav-active.weight": {"type":"number","value":700},
    "type.nav.color": {"type":"color","value":"$color.text-sidebar"},
    "type.nav.family": {"type":"string","value":"$font.sans"},
    "type.nav.size": {"type":"number","value":16},
    "type.nav.style": {"type":"string","value":"normal"},
    "type.nav.tracking": {"type":"number","value":0},
    "type.nav.weight": {"type":"number","value":500},
