      "textStyles": {
        "body": {
          "group": "Type",
          "description": "Default UI text, setting labels, values.",
          "properties": {
            "fill": "$type.body.color",
            "fontFamily": "$type.body.family",
            "fontSize": "$type.body.size",
            "fontStyle": "$type.body.style",
            "fontWeight": "$type.body.weight",
            "letterSpacing": "$type.body.tracking"
          }
        },
        "body-strong": {
          "group": "Type",
          "description": "Game names under covers, emphasised values.",
          "properties": {
            "fill": "$type.body-strong.color",
            "fontFamily": "$type.body-strong.family",
            "fontSize": "$type.body-strong.size",
            "fontStyle": "$type.body-strong.style",
            "fontWeight": "$type.body-strong.weight",
            "letterSpacing": "$type.body-strong.tracking"
          }
        },
        "caption": {
          "group": "Type",
          "description": "Setting descriptions, subtitles, secondary info.",
          "properties": {
            "fill": "$type.caption.color",
            "fontFamily": "$type.caption.family",
            "fontSize": "$type.caption.size",
            "fontStyle": "$type.caption.style",
            "fontWeight": "$type.caption.weight",
            "letterSpacing": "$type.caption.tracking"
          }
        },
        "display": {
          "group": "Type",
          "description": "Game title on the detail page.",
          "properties": {
            "fill": "$type.display.color",
            "fontFamily": "$type.display.family",
            "fontSize": "$type.display.size",
            "fontStyle": "$type.display.style",
            "fontWeight": "$type.display.weight",
            "letterSpacing": "$type.display.tracking"
          }
        },
        "heading": {
          "group": "Type",
          "description": "Card titles (Play history, Details), brand wordmark.",
          "properties": {
            "fill": "$type.heading.color",
            "fontFamily": "$type.heading.family",
            "fontSize": "$type.heading.size",
            "fontStyle": "$type.heading.style",
            "fontWeight": "$type.heading.weight",
            "letterSpacing": "$type.heading.tracking"
          }
        },
        "nav": {
          "group": "Type",
          "description": "Main sidebar rows.",
          "properties": {
            "fill": "$type.nav.color",
            "fontFamily": "$type.nav.family",
            "fontSize": "$type.nav.size",
            "fontStyle": "$type.nav.style",
            "fontWeight": "$type.nav.weight",
            "letterSpacing": "$type.nav.tracking"
          }
        },
        "nav-active": {
          "group": "Type",
          "description": "Selected main sidebar row, Big Picture button.",
          "properties": {
            "fill": "$type.nav-active.color",
            "fontFamily": "$type.nav-active.family",
            "fontSize": "$type.nav-active.size",
            "fontStyle": "$type.nav-active.style",
            "fontWeight": "$type.nav-active.weight",
            "letterSpacing": "$type.nav-active.tracking"
          }
        },
        "overline": {
          "group": "Type",
          "description": "Uppercase section labels (VIEWS, LANGUAGE, GOG). Write content in capitals.",
          "properties": {
            "fill": "$type.overline.color",
            "fontFamily": "$type.overline.family",
            "fontSize": "$type.overline.size",
            "fontStyle": "$type.overline.style",
            "fontWeight": "$type.overline.weight",
            "letterSpacing": "$type.overline.tracking"
          }
        },
        "title": {
          "group": "Type",
          "description": "Page title (Library, General).",
          "properties": {
            "fill": "$type.title.color",
            "fontFamily": "$type.title.family",
            "fontSize": "$type.title.size",
            "fontStyle": "$type.title.style",
            "fontWeight": "$type.title.weight",
            "letterSpacing": "$type.title.tracking"
          }
        }
      },
      "components": {
        "badge": {
          "group": "Data",
          "description": "Small tag such as a platform name."
        },
        "button-icon": {
          "group": "Actions",
          "description": "Round icon-only action: favourite, refresh, more."
        },
        "button-primary": {
          "group": "Actions",
          "description": "The one main action on a screen (Locate files, Install, Play). Swap the icon or hide it."
        },
        "button-secondary": {
          "group": "Actions",
          "description": "Toolbar actions: Add game, Filters, Views, Sort, Select."
        },
        "card": {
          "group": "Layout",
          "description": "Rounded content card with heading, card-actions slot (e.g. segmented control) and card-body slot."
        },
        "detail-row": {
          "group": "Data",
          "description": "Label / value row for the game Details card."
        },
        "game-card": {
          "group": "Library",
          "description": "Library grid tile: cover (placeholder shows the title) with name and status below. Fill game-card-cover with an image fill for real art."
        },
        "input-path": {
          "group": "Inputs",
          "description": "Folder path field with browse icon, used in settings rows."
        },
        "input-search": {
          "group": "Inputs",
          "description": "Search fields (library, settings)."
        },
        "nav-item": {
          "group": "Navigation",
          "description": "Main sidebar row. Override nav-item-icon (icon) and nav-item-label."
        },
        "nav-item-active": {
          "group": "Navigation",
          "description": "Selected main sidebar row with the ember indicator bar."
        },
        "segment": {
          "group": "Navigation",
          "description": "Item inside a segmented control."
        },
        "segment-active": {
          "group": "Navigation",
          "description": "Selected item inside a segmented control."
        },
        "segmented-control": {
          "group": "Navigation",
          "description": "Filter pills such as All / Installed / Not installed, Grid / List / Focus, Timeline / Sessions / Journal."
        },
        "select": {
          "group": "Inputs",
          "description": "Dropdown select (Language)."
        },
        "setting-row": {
          "group": "Settings",
          "description": "One setting: title, description and a control in the setting-row-control slot (toggle, select, path input). Place inside settings-card-body; the last row's bottom border may be hidden."
        },
        "settings-card": {
          "group": "Settings",
          "description": "Uppercase section label plus a rounded card; fill the settings-card-body slot with setting-row instances."
        },
        "settings-nav-item": {
          "group": "Navigation",
          "description": "Settings sub-navigation row."
        },
        "settings-nav-item-active": {
          "group": "Navigation",
          "description": "Selected settings sub-navigation row."
        },
        "sidebar": {
          "group": "Layout",
          "description": "App sidebar. Move the active state by swapping nav-item / nav-item-active instances' overrides."
        },
        "tab": {
          "group": "Navigation",
          "description": "Underline tab (game page About / Compatibility / Extras / Mods)."
        },
        "tab-active": {
          "group": "Navigation",
          "description": "Selected underline tab."
        },
        "title-bar": {
          "group": "Layout",
          "description": "Window title bar with back/forward, command search and downloads. 1280 wide; stretch to the window."
        },
        "toggle-off": {
          "group": "Inputs",
          "description": "Switch, off."
        },
        "toggle-on": {
          "group": "Inputs",
          "description": "Switch, on."
        },
        "view-item": {
          "group": "Navigation",
          "description": "Saved view under the VIEWS heading in the sidebar."
        }
      }
    }
  }
}
